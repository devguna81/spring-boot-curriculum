<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jqdom.curriculum.ch36.order.internal.OrderMapper">

    <select id="countByMemberIds" resultType="com.jqdom.curriculum.ch36.order.internal.OrderCountRow">
        SELECT member_id, COUNT(*) AS order_count
        FROM orders
        WHERE member_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY member_id
    </select>
</mapper>
